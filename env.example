# Backend API base URL (without trailing slash)
API_BASE_URL=http://localhost:8001

# Public API URL baked into the browser for uploads. CRM data calls use the proxy when the next flag is true.
NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_USE_API_PROXY=true

# CORS Configuration (comma-separated list of allowed origins)
# Leave empty or set to '*' for development
# Example for production: https://yourcrm.yourdomain.com
CORS_ORIGINS=*

# Environment
NODE_ENV=development

# Optional: Error Reporting Service (e.g., Sentry)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
